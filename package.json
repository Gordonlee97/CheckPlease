{
  "name": "checkplease",
  "version": "0.1.0",
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ios": "cross-env NEXT_PUBLIC_SCAN_API_URL=https://checkplease.vercel.app/api/scan NEXT_PUBLIC_SHARE_BASE_URL=https://checkplease.vercel.app next build && npx cap sync ios",
    "open:ios": "npx cap open ios",
    "build:android": "cross-env NEXT_PUBLIC_SCAN_API_URL=https://checkplease.vercel.app/api/scan NEXT_PUBLIC_SHARE_BASE_URL=https://checkplease.vercel.app next build && npx cap sync android",
    "open:android": "npx cap open android",
    "start": "next start",
    "lint": "eslint",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@capacitor/android": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "@capacitor/ios": "^7.6.2",
    "idb": "^8.0.3",
    "lz-string": "^1.5.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
